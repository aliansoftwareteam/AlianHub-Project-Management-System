{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "alianhub-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "nodemon"],
      "port": 4000
    },
    {
      "name": "alianhub-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "serve"],
      "port": 8080
    },
    {
      "name": "docs-site",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "docs-site", "run", "docs:preview", "--", "--port", "4173"],
      "port": 4173
    }
  ]
}
