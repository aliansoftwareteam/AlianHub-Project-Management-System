            "description": "task.task_description",
            "rawDescription": "task.task_description",
            "Task_Priority": "task.task_priority",
            "DueDate": "task.task_due_date",
            "startDate": "task.task_start_date",
            "tagsArray": "task.task_tag",
            "checklistArray": "task.task_checklist",
            "points": "task.task_estimated_hours",
            "totalEstimatedTime": "task.task_estimated_hours"
          }
        }
      },
      {
        "key": "task.sprint.move",
