          "key": "task.task_list",
          "write": false
        }
      },
      {
        "key": "deploy.staging",
        "label": "Propose a staging deploy",
        "risk": "high",
        "undoable": false,
        "write": true,
        "cost": "write",
        "gate": "owner_admin",
        "proposeOnly": true,
        "permission": "settings.settings_edit_company"
      }
    ],
    "never": [
      "project.delete",
      "task.delete",
      "billing.*",
      "deploy.production",
      "git.merge",
      "member.remove",
      "permissions.edit",
      "status.set(\"Done\")"
    ],
    "agentStatusNames": [
      "in progress",
      "in review"
    ],
    "autonomy": [
      {
        "level": 0,
        "label": "Assist — answers only, proposes nothing on its own",
        "actsOn": []
      },
      {
        "level": 1,
        "label": "Suggest — proposes everything, a person approves",
        "actsOn": []
      },
      {
        "level": 2,
        "label": "Act in bounds — low and medium risk directly, proposes the rest",
        "actsOn": [
          "low",
          "medium"
        ]
      },
      {
        "level": 3,
        "label": "Scheduled — as L2, and may run unattended",
        "actsOn": [
          "low",
          "medium"
        ]
      }
    ]
  },
