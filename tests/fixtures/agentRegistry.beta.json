        "undoable": true,
        "write": true,
        "cost": "write",
        "permission": "task.task_move"
      },
      {
        "key": "subtask.create",
        "label": "Create a subtask",
        "risk": "low",
        "undoable": true,
        "write": true,
        "cost": "write",
        "permission": "task.sub_task_create"
      },
      {
        "key": "task.create",
        "label": "File a task (opening status, unassigned)",
