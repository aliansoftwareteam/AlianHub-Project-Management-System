  "registryManifest": {
    "actions": [
      {
        "key": "tasks.next",
        "label": "Next assigned task",
        "risk": "low",
        "undoable": false,
        "write": false,
        "cost": "read",
        "permission": "task.task_list"
      },
      {
        "key": "tasks.search",
        "label": "Search own tasks",
        "risk": "low",
        "undoable": false,
        "write": false,
        "cost": "read",
