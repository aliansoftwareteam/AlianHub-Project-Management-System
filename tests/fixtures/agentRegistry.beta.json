  "toolManifest": [
    {
      "name": "tasks.next",
      "description": "The next task assigned to you, highest priority and nearest due date first. Start here.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "tasks.search",
      "description": "Search tasks you can see by text, status or project.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "task.get",
      "description": "A task as a brief: goal, acceptance criteria, relations, linked docs and what the comment thread has settled. Read this before writing code.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          }
        },
        "required": [
          "taskId"
        ]
      }
    },
    {
      "name": "task.comment",
      "description": "Post a comment. Use it to report findings, ask a question, or leave a PR link with context.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "taskId",
          "body"
        ]
      }
    },
    {
      "name": "task.status.set",
      "description": "Move a task to In progress or In review. Done is not available to agents — a person closes the task.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "taskId",
          "status"
        ]
      }
    },
    {
      "name": "task.link",
      "description": "Attach a pull request, branch or document URL to the task.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "taskId",
          "url"
        ]
      }
    },
    {
      "name": "task.create",
      "description": "File a new task in a project, in its opening status and unassigned. Use it for work you found that is not on the board yet; put the goal and acceptance criteria in the description.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "sprintId": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "URGENT",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          }
        },
        "required": [
          "projectId",
          "title"
        ]
      }
    },
    {
      "name": "subtask.create",
      "description": "Break the task down. One subtask per call.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "taskId",
          "title"
        ]
      }
    },
    {
      "name": "timelog.start",
      "description": "Start the timer on a task so the hours you spend are attributed to you.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          }
        },
        "required": [
          "taskId"
        ]
      }
    },
    {
      "name": "timelog.stop",
      "description": "Stop the running timer and write the time log.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "taskId"
        ]
      }
    },
    {
      "name": "docs.read",
      "description": "Read a page linked from a task, by page id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pageId": {
            "type": "string"
          }
        },
        "required": [
          "pageId"
        ]
      }
    }
  ]
}
