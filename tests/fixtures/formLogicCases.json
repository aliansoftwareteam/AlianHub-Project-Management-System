  "forms": [
    {
      "name": "any of: one condition holding is enough",
      "questions": [
        { "id": "a", "type": "short_text", "label": "A" },
        { "id": "b", "type": "number", "label": "B" },
        { "id": "t", "type": "short_text", "label": "T", "showWhen": { "any": [{ "question": "a", "op": "equals", "value": "yes" }, { "question": "b", "op": "greater_than", "value": 3 }] } }
      ],
      "answers": { "a": "no", "b": "4" },
      "shown": ["a", "b", "t"]
    },
    {
      "name": "all of: one condition failing hides the question",
      "questions": [
        { "id": "a", "type": "short_text", "label": "A" },
        { "id": "b", "type": "number", "label": "B" },
        { "id": "t", "type": "short_text", "label": "T", "showWhen": { "all": [{ "question": "a", "op": "equals", "value": "yes" }, { "question": "b", "op": "greater_than", "value": 3 }] } }
      ],
      "answers": { "a": "yes", "b": "3" },
      "shown": ["a", "b"]
    },
    {
      "name": "a group inside a group",
      "questions": [
        { "id": "a", "type": "short_text", "label": "A" },
        { "id": "b", "type": "number", "label": "B" },
        { "id": "c", "type": "date", "label": "C" },
        { "id": "t", "type": "short_text", "label": "T", "showWhen": { "all": [{ "question": "a", "op": "is_not_empty" }, { "any": [{ "question": "b", "op": "less_than", "value": 0 }, { "question": "c", "op": "greater_than", "value": "2026-01-01" }] }] } }
      ],
      "answers": { "a": "x", "b": "5", "c": "2026-06-01" },
      "shown": ["a", "b", "c", "t"]
    },
    {
      "name": "a group inside a group, the inner one failing",
      "questions": [
        { "id": "a", "type": "short_text", "label": "A" },
        { "id": "b", "type": "number", "label": "B" },
        { "id": "c", "type": "date", "label": "C" },
        { "id": "t", "type": "short_text", "label": "T", "showWhen": { "all": [{ "question": "a", "op": "is_not_empty" }, { "any": [{ "question": "b", "op": "less_than", "value": 0 }, { "question": "c", "op": "greater_than", "value": "2026-01-01" }] }] } }
      ],
      "answers": { "a": "x", "b": "5", "c": "2025-06-01" },
      "shown": ["a", "b", "c"]
    },
    {
      "name": "an answer to a hidden question does not count for the questions after it",
      "questions": [
        { "id": "a", "type": "short_text", "label": "A" },
        { "id": "b", "type": "short_text", "label": "B", "showWhen": { "all": [{ "question": "a", "op": "equals", "value": "yes" }] } },
        { "id": "c", "type": "short_text", "label": "C", "showWhen": { "all": [{ "question": "b", "op": "is_not_empty" }] } }
      ],
      "answers": { "a": "no", "b": "typed before it was hidden" },
      "shown": ["a"]
    },
    {
      "name": "a chain that holds all the way down",
      "questions": [
        { "id": "a", "type": "short_text", "label": "A" },
        { "id": "b", "type": "short_text", "label": "B", "showWhen": { "all": [{ "question": "a", "op": "equals", "value": "yes" }] } },
        { "id": "c", "type": "short_text", "label": "C", "showWhen": { "all": [{ "question": "b", "op": "is_not_empty" }] } }
      ],
      "answers": { "a": "yes", "b": "typed" },
      "shown": ["a", "b", "c"]
    },
    {
      "name": "a question hidden from the form stays hidden whatever its rule says",
      "questions": [
        { "id": "a", "type": "short_text", "label": "A" },
        { "id": "b", "type": "short_text", "label": "B", "hidden": true },
        { "id": "c", "type": "short_text", "label": "C", "hidden": true, "showWhen": { "all": [{ "question": "a", "op": "is_not_empty" }] } }
      ],
      "answers": { "a": "x" },
      "shown": ["a"]
    },
    {
      "name": "no rule, a null rule and an empty rule all mean shown",
      "questions": [
        { "id": "a", "type": "short_text", "label": "A" },
        { "id": "b", "type": "short_text", "label": "B", "showWhen": null },
        { "id": "c", "type": "short_text", "label": "C", "showWhen": { "all": [] } }
      ],
      "answers": {},
      "shown": ["a", "b", "c"]
    },
    {
      "name": "an information block can be shown by a rule",
      "questions": [
        { "id": "a", "type": "number", "label": "A" },
        { "id": "note", "type": "info_block", "label": "Large orders", "showWhen": { "all": [{ "question": "a", "op": "greater_than", "value": 100 }] } }
      ],
      "answers": { "a": "50" },
      "shown": ["a"]
    }
  ],
  "malformed": [
    { "name": "a code string", "rule": "answers.a === 'yes'" },
    { "name": "a list", "rule": [{ "question": "a", "op": "is_empty" }] },
    { "name": "both all and any", "rule": { "all": [{ "question": "a", "op": "is_empty" }], "any": [{ "question": "a", "op": "is_empty" }] } },
    { "name": "an unknown group key", "rule": { "none": [{ "question": "a", "op": "is_empty" }] } },
    { "name": "a group that is not a list", "rule": { "all": { "question": "a", "op": "is_empty" } } },
    { "name": "an unknown operator", "rule": { "all": [{ "question": "a", "op": "matches", "value": ".*" }] } },
    { "name": "an extra key on a condition", "rule": { "all": [{ "question": "a", "op": "is_empty", "script": "alert(1)" }] } },
    { "name": "a value on an operator that takes none", "rule": { "all": [{ "question": "a", "op": "is_empty", "value": "x" }] } },
    { "name": "a missing value", "rule": { "all": [{ "question": "a", "op": "equals" }] } },
    { "name": "an empty text value", "rule": { "all": [{ "question": "a", "op": "equals", "value": "  " }] } },
    { "name": "an operator the question type does not offer", "rule": { "all": [{ "question": "n", "op": "contains", "value": "1" }] } },
    { "name": "a text value for a number question", "rule": { "all": [{ "question": "n", "op": "greater_than", "value": "10" }] } },
    { "name": "a date that is not a day", "rule": { "all": [{ "question": "d", "op": "equals", "value": "tomorrow" }] } },
    { "name": "an option the question does not have", "rule": { "all": [{ "question": "k", "op": "equals", "value": "o9" }] } },
    { "name": "one_of with no list", "rule": { "all": [{ "question": "k", "op": "one_of", "value": "o1" }] } },
    { "name": "one_of with an empty list", "rule": { "all": [{ "question": "k", "op": "one_of", "value": [] }] } },
    { "name": "a question that is not on the form", "rule": { "all": [{ "question": "nowhere", "op": "is_empty" }] } },
    { "name": "a question hidden from the form", "rule": { "all": [{ "question": "h", "op": "is_empty" }] } },
    { "name": "a file question", "rule": { "all": [{ "question": "f", "op": "is_empty" }] } },
    { "name": "the question itself", "rule": { "all": [{ "question": "t", "op": "is_empty" }] } },
    { "name": "a question further down", "rule": { "all": [{ "question": "z", "op": "is_empty" }] } },
    { "name": "an empty group inside", "rule": { "all": [{ "any": [] }] } },
    {
      "name": "three levels of groups",
      "rule": { "all": [{ "any": [{ "all": [{ "question": "a", "op": "is_empty" }] }] }] }
    },
    {
      "name": "eleven conditions",
      "rule": {
        "any": [
          { "question": "a", "op": "equals", "value": "1" }, { "question": "a", "op": "equals", "value": "2" },
          { "question": "a", "op": "equals", "value": "3" }, { "question": "a", "op": "equals", "value": "4" },
          { "question": "a", "op": "equals", "value": "5" }, { "question": "a", "op": "equals", "value": "6" },
          { "question": "a", "op": "equals", "value": "7" }, { "question": "a", "op": "equals", "value": "8" },
          { "question": "a", "op": "equals", "value": "9" }, { "question": "a", "op": "equals", "value": "10" },
          { "question": "a", "op": "equals", "value": "11" }
        ]
      }
    }
  ],
