# Frontend build-time variables (inlined by Vue CLI). Generated by scripts/env-doc.js.
# Copy to frontend/.env and fill in; the CI build uses placeholders.

# Show the affiliate programme entry points.
# VUE_APP_AFFILIATEON=""
# Firebase web API key (push notifications). (secret)
# VUE_APP_APIKEY=""
# Firebase app id.
# VUE_APP_APPID=""
# Firebase auth domain.
# VUE_APP_AUTHDOMAIN=""
# Custom field id used by the support product link.
# VUE_APP_CUSTOMFIELDID=""
# Custom field id that stores the product on support tickets.
# VUE_APP_CUSTOMFIELDPRODUCTID=""
# GitHub OAuth authorize URL.
# VUE_APP_GITHUB_BASE_OAUTH_URL=""
# GitHub OAuth client id for the login button.
# VUE_APP_GITHUB_CLIENT_ID=""
# GitLab OAuth authorize URL.
# VUE_APP_GITLAB_BASE_OAUTH_URL=""
# GitLab OAuth client id for the login button.
# VUE_APP_GITLAB_CLIENT_ID=""
# Google OAuth client id for the login button.
# VUE_APP_GOOGLE_CLIENT_ID=""
# Show the GitHub login button.
# VUE_APP_IS_GITHUB_LOGIN=""
# Show the GitLab login button.
# VUE_APP_IS_GITLAB_LOGIN=""
# Show the Google login button.
# VUE_APP_IS_GOOGLE_LOGIN=""
# Show the SSO login entry point.
# VUE_APP_IS_SSO_LOGIN=""
# Firebase analytics measurement id.
# VUE_APP_MEASUREMENTID=""
# Firebase messaging sender id.
# VUE_APP_MESSAGINGSENDERID=""
# Firebase project id.
# VUE_APP_PROJECTID=""
# Firebase storage bucket.
# VUE_APP_STORAGEBUCKET=""
# Storage backend the web app assumes (server or wasabi); mirror STORAGE_TYPE.
# VUE_APP_STORAGE_TYPE=""
# Company id that receives support tickets raised from the app.
# VUE_APP_SUPPORT_COMPANYID=""
# Mailbox shown for support requests.
# VUE_APP_SUPPORT_MAIL=""
# Project id that receives support tickets raised from the app.
# VUE_APP_SUPPORT_PROJECTID=""
# Default account email pre-filled on demo builds.
# VUE_APP_USEREMAIL=""
