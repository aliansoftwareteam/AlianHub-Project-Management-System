# ─────────────────────────────────────────
# QUICK START
# Run `npm run setup` — it copies this file to .env and auto-fills:
#   JWT_SECRET, PRECOMPANYKEY  (random secure values)
#   STORAGE_TYPE               (set to "server" — no cloud storage needed for local dev)
# Everything else can be set on the setup page and in Settings → Instance.
# ─────────────────────────────────────────

# ─────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────
PORT=4000
NODE_ENV="development"                     # development | production
APP_NAME="AlianHub"
UNDER_MAINTENANCE="false"                  # true | false

# ─────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────
# Empty on purpose — the setup page fills this in. A value here wins over what you type
# in the wizard, so set it by hand only if you are skipping the wizard.
MONGODB_URL=""                             # REQUIRED — mongo connection string (no trailing slash)
MONGO_CLOUD_URL="https://cloud.mongodb.com/api"

# ─────────────────────────────────────────
# AUTH / JWT
# ─────────────────────────────────────────
JWT_SECRET="your_jwt_secret_here"         # REQUIRED
JWT_EXP="24h"
JWT_ALGORITHM="HS256"

# Two-factor auth (TOTP) — all OPTIONAL. 2FA works without them (safe values are
# derived from JWT_SECRET), but set dedicated secrets in production so rotating
# JWT_SECRET doesn't break stored 2FA secrets or in-flight login second-steps.
TWO_FACTOR_ENC_KEY=""                      # key material for encrypting TOTP secrets at rest
TWO_FACTOR_TEMP_SECRET=""                  # signs the short-lived login second-step (temp) token
TWO_FACTOR_ISSUER="AlianHub"               # label shown in the user's authenticator app


# How long (in seconds) the per-(user, company) membership lookup is cached
# after a successful authenticated request. Lower values pick up membership
# changes (add / remove member) faster at the cost of an extra Mongo query;
# higher values are cheaper but widen the window where a removed user can
# still call the API. Default 60s. Set to 0 to bypass the cache entirely.
MEMBERSHIP_CACHE_TTL_SECONDS="60"

# Login / forgot-password / reset-password rate-limit (per IP).
# - MAX_ATTEMPTS: failed attempts before the IP is blocked (default 5).
# - WINDOW_MS:    rolling-window length the attempts are counted in (default 15 min).
# - BLOCK_MS:     how long the IP stays blocked once tripped (default 30 min).
AUTH_RATE_LIMIT_MAX_ATTEMPTS="5"
AUTH_RATE_LIMIT_WINDOW_MS="900000"
AUTH_RATE_LIMIT_BLOCK_MS="1800000"


# ─────────────────────────────────────────
# OAUTH / SOCIAL LOGIN (Google + GitHub)
# Optional — leave blank to keep social login disabled. Buttons only appear
# when the matching VUE_APP_IS_*_LOGIN flag (frontend/.env) is "true".
#
# The browser performs the OAuth popup/redirect, then the backend (a) exchanges
# the code for tokens and (b) re-verifies the identity with the provider before
# logging anyone in — so these client ids/secrets are REQUIRED for login to work.
# ─────────────────────────────────────────

# Google — create an OAuth 2.0 Client ID (type: Web application) at
#   https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: your WEBURL (e.g. http://localhost:8080 in dev).
# The same client id must also be set as VUE_APP_GOOGLE_CLIENT_ID in frontend/.env.
GOOGLE_CLIENT_ID=""                        # used for token exchange AND id-token verification
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_URL="https://oauth2.googleapis.com/token"   # Google token endpoint
GOOGLE_OAUTH_REQUIRED="true"               # "true" rejects logins that fail id-token verification (recommended)

# GitHub — create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: your WEBURL (the SPA reads the ?code= on return).
# The same client id must also be set as VUE_APP_GITHUB_CLIENT_ID in frontend/.env,
# and VUE_APP_GITHUB_BASE_OAUTH_URL=https://github.com/login/oauth.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_BASE_OAUTH_URL="https://github.com/login/oauth"   # authorize + access_token base
GITHUB_OAUTH_REQUIRED="true"               # "true" requires server-side verification via GitHub /user (recommended)

# GitLab — create an Application at https://gitlab.com/-/profile/applications
# Redirect URI: your WEBURL (the SPA reads ?code= on return). Scope: read_user.
# The same client id must also be set as VUE_APP_GITLAB_CLIENT_ID in frontend/.env,
# and VUE_APP_GITLAB_BASE_OAUTH_URL=https://gitlab.com/oauth.
# For self-managed GitLab, point the *_BASE_OAUTH_URL / *_BASE_API_URL at your host.
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""
GITLAB_BASE_OAUTH_URL="https://gitlab.com/oauth"         # authorize + token base
GITLAB_BASE_API_URL="https://gitlab.com/api/v4"          # used to verify the identity (/user)
GITLAB_OAUTH_REQUIRED="true"               # "true" requires server-side verification via GitLab /user (recommended)

# ─────────────────────────────────────────
# APP URLs
# ─────────────────────────────────────────
APIURL="http://localhost:4000/"
WEBURL="http://localhost:4000"

# Optional extra browser origins (comma-separated, no trailing slash) that
# should be allowed to call the API and open Socket.io connections in
# addition to WEBURL / APIURL. Use this for multi-domain deployments
# (e.g. a staging frontend on a separate host). Leave blank in single-
# domain setups.
CORS_ORIGINS="http://localhost:8080"

# ─────────────────────────────────────────
# STORAGE
# ─────────────────────────────────────────
STORAGE_TYPE="wasabi"                     # wasabi | server

# Upper limits for images sent through sharp (BUG-023 fix).
# - MAX_IMAGE_FILE_BYTES bounds the file/buffer size in bytes (default 25 MB).
# - MAX_IMAGE_PIXELS bounds the on-disk pixel count to prevent
#   pixel-bomb DoS (e.g. a 30000x30000 PNG). Default 50 megapixels
#   (≈ 7100x7100).
MAX_IMAGE_FILE_BYTES="26214400"
MAX_IMAGE_PIXELS="50000000"

# Wasabi S3-compatible storage
WASABI_ACCESS_KEY=""
WASABI_SECRET_ACCESS_KEY=""
WASABI_USERID=""
WASABIENDPOINT="https://s3.wasabisys.com"
WASABI_REGION="us-east-1"
IAM_ENDPOINT="https://iam.wasabisys.com"
USERPROFILEBUCKET="your-bucket-name"

# ─────────────────────────────────────────
# EMAIL — Nodemailer (SMTP)
# ─────────────────────────────────────────
NODEMAILER_HOST="smtp.gmail.com"
NODEMAILER_PORT="587"                     # 587 (STARTTLS) or 465 (SSL)
NODEMAILER_EMAIL="your@email.com"
NODEMAILER_EMAIL_PASSWORD=""              # Use app password for Gmail

# ─────────────────────────────────────────
# EMAIL — Resend HTTP API (recommended for cloud hosting)
# Set RESEND_API_KEY to use Resend instead of SMTP
# ─────────────────────────────────────────
RESEND_API_KEY=""                         # Get from resend.com
RESEND_FROM_EMAIL="onboarding@resend.dev" # Use verified domain in production

# ─────────────────────────────────────────
# FIREBASE (push notifications)
# Leave blank to disable push notifications
# ─────────────────────────────────────────
SERVICE_FILE="./firebase-adminsdk.json"   # Path to Firebase service account JSON (must be inside project root)
APIKEY=""
AUTODOMAIN=""
PROJECTID=""
STORAGEBUCKET=""
MESSAGINGSENDERID=""
APPID=""
MEASUREMENTID=""

# ─────────────────────────────────────────
# SOCKET.IO ADMIN UI (optional)
# Leave both blank to disable the admin UI (recommended for production
# unless you actively need it). Both values must be set to enable.
# Username is plain text. Password must be a bcrypt hash — generate with:
#   node -e "console.log(require('bcrypt').hashSync(process.argv[1], 12))" '<your-password>'
# ─────────────────────────────────────────
SOCKETIO_ADMIN_USERNAME="alian"
SOCKETIO_ADMIN_PASSWORD_HASH="$2a$12$HHemhzmTrC8Dmf2Gd9v/Teo9oiCxfYJb.St3HKMBx1L3wJmZLeX5u"

# ─────────────────────────────────────────
# AUTOMATION ENGINE
# ─────────────────────────────────────────
# Phase 0 diagnostic. When "true", every canonical domain event is recorded to the
# automation_event_log collection (14-day TTL) so you can see which events the
# engine actually receives before rules are built on them. Observation only —
# nothing is executed either way. Leave "false" in production.
AUTOMATION_EVENT_LOG="false"

# Master switch for rule execution. On by default so rules saved from the
# Automations page actually run; set "false" to keep rules stored but inert.
AUTOMATION_ENGINE="true"

# "agenda" (durable, MongoDB-backed, survives a restart) or "inline" (in-process,
# nothing survives a restart — tests and throwaway instances only).
AUTOMATION_QUEUE_DRIVER="agenda"

# Concurrent runs per worker.
AUTOMATION_CONCURRENCY="5"

# ─────────────────────────────────────────
# AI
# ─────────────────────────────────────────
LLM_PROVIDER="openai"                          # openai | anthropic | deepseek
AI_API_KEY=""
AI_MODEL="gpt-4.1"                              # recommended: gpt-4o or gpt-4.1 for best instruction-following on complex plans
                                               # gpt-5-mini / gpt-4o-mini work but produce fewer, more bundled tasks
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"   # current Sonnet 4.5 model id
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-v4-flash"                 # deepseek-chat / deepseek-reasoner / deepseek-v4-flash / deepseek-v4-pro (all V4: 1M ctx, up to 384K output)
                                               # reasoner & pro use "thinking" mode — they spend extra output tokens on reasoning, so raise LLM_MAX_TOKENS_PLAN if large plans truncate
LLM_MAX_TOKENS_PLAN=32000                      # cap for the planning call (raise if you see "ran out of output token budget")
LLM_MAX_TOKENS_CLARIFY=2000                    # cap for follow-up Q&A
# Model prices, USD per 1M tokens, per model id. Current OpenAI, Anthropic and DeepSeek
# models are priced by default; set this to correct a default after a vendor change or to
# price a model the list does not know. A model with no price on file is refused before it
# runs (agent runs, budgets and caps would otherwise count it as $0). Use 0/0 for a free
# or self-hosted model. Also editable under Instance settings → AI.
# LLM_PRICING='{"gpt-4.1":{"input":2,"output":8},"my-local-llama":{"input":0,"output":0}}'
# LLM_TIMEOUT_MS=600000                        # model call timeout every provider inherits (default 10 min); the agent job lock is derived from it
# AGENT_ACT_BUDGET_MS=300000                   # act-phase budget added to the model timeout when sizing the agent job lock (default 5 min)
# ANTHROPIC_TIMEOUT_MS=600000                  # optional: override the Anthropic SDK timeout (default LLM_TIMEOUT_MS)
# OPENAI_TIMEOUT_MS=600000                     # optional: override the OpenAI axios timeout (default: LLM_TIMEOUT_MS for reasoning/gpt-5, 4 min for others)
# DEEPSEEK_TIMEOUT_MS=600000                   # optional: override the DeepSeek axios timeout (default: LLM_TIMEOUT_MS for reasoner, 4 min for chat)
# DEEPSEEK_BASE_URL="https://api.deepseek.com" # optional: override DeepSeek base URL (e.g. for a compatible proxy)

# ─────────────────────────────────────────
# DEMO MODE (public demo instances only)
# When DEMO_MODE=true, the app shows a "you're on the live demo" banner with
# the shared demo credentials and a "deploy your own" link. Leave false for
# real deployments. Only set DEMO_EMAIL/DEMO_PASSWORD on a throwaway demo DB.
# ─────────────────────────────────────────
DEMO_MODE="false"
DEMO_EMAIL=""
DEMO_PASSWORD=""

# ─────────────────────────────────────────
# AUDIO / VIDEO CALLING (main chat)
# ─────────────────────────────────────────
# Calling is peer-to-peer: media goes browser-to-browser and never touches this
# server. Two things are needed for it to work in the real world.
#
# 1. HTTPS. Browsers only grant microphone and camera access in a secure context,
#    so calling is unavailable over plain HTTP (localhost excepted). Nothing to
#    configure here — but on http:// the call buttons will not appear.
#
# 2. STUN, and in practice TURN. STUN lets each browser discover its own public
#    address, which is enough on most home and office networks. TURN relays the
#    media when a direct path cannot be found — symmetric NAT and strict
#    corporate firewalls, roughly 15-20% of real connections. WITHOUT TURN those
#    calls simply fail to connect.
#
# Leave these empty to run without a relay: most calls still work, some will not.
STUN_URLS="stun:stun.l.google.com:19302"
# Comma-separated, e.g. "turn:turn.example.com:3478,turns:turn.example.com:5349"
TURN_URLS=""
# PREFERRED: coturn's `use-auth-secret` / REST mode. The server mints a short-lived
# credential per request, so nothing long-lived is ever handed to a browser.
# Must match `static-auth-secret` in turnserver.conf.
TURN_STATIC_AUTH_SECRET=""
TURN_CREDENTIAL_TTL_SECONDS=3600
# FALLBACK: static credentials, for managed TURN providers that offer nothing else.
# Weaker — this username and password are visible to anyone who opens devtools.
TURN_USERNAME=""
TURN_PASSWORD=""

# ─────────────────────────────────────────
# DOCKER COMPOSE (read by docker-compose.yml, not by the app)
# ─────────────────────────────────────────
# Container names. The defaults match earlier releases; change them to run a second
# copy on the same host (`docker compose -p <name>`), which also needs its own volumes
# and network, since those names are fixed in docker-compose.yml.
# ALIANHUB_APP_CONTAINER="alianhub"
# ALIANHUB_MONGO_CONTAINER="alianhub-mongo"
# ALIANHUB_COTURN_CONTAINER="alianhub-coturn"

# ─────────────────────────────────────────
# MISC
# ─────────────────────────────────────────
NOOFPRESETCOMPANY=10
PRECOMPANYKEY="your_preset_key"
ERRORRECIVEREMAIL="admin@yourdomain.com"  # Email to receive error alerts
ENDPOINT_KEY=""

# Brings an EXISTING company's permission list up to date with the current catalogue, once, the
# next time an admin opens Settings > Security & Permissions. Off by default and it should stay
# off: the repair clears the permission collection before rewriting it, so on a busy installation
# a permission check in that instant is refused. Turn it on, load the screen once, turn it off.
# A company created by this version is already current and never needs it.

# ── generated by scripts/env-doc.js — do not edit below; run `node scripts/env-doc.js` ──
# Every variable the backend reads that is not set above. Defaults apply when unset.

# JOBS
# Minutes between runs of the agent rate-alert evaluator (error rate, approval rate, cost forecast, queue age).
# AGENT_ALERTS_INTERVAL_MINUTES=15

# SECURITY
# Set to true to route every agent fetch through the workspace egress gateway: a workspace whose list under Instance > Egress names hosts lets its agents fetch those hosts only, checked on every redirect hop and again against the resolved address, with each refusal audited as agent.egress_refused naming the host. Entries are exact hostnames or *.suffix patterns with an optional port; an entry without a port allows that host on any port and over plain http as well as https, so write host:443 to allow https on its default port only. Wildcards on shared-hosting and wildcard-DNS suffixes (*.github.io, *.nip.io, ...) are refused. A workspace with no list, and every workspace while this is unset or false, fetches as before: public hosts allowed, private, metadata and link-local hosts refused. Private hosts stay refused even when listed. Turning this on also judges NAT64, 6to4 and IPv4-compatible IPv6 addresses by the IPv4 address they carry, and that rule is shared, so it applies to webhook URL checks on save and to the Integrations public-URL check as well. Not behind the gateway: model provider and embeddings calls, SMTP, file storage, and webhooks fired by task changes an agent makes.
# AGENT_EGRESS_ALLOWLIST=false

# AI
# The performance.read agent action: "on" registers it and offers it over MCP, so an agent can read logged time, estimate against actual, sprint velocity and cumulative flow for up to 5 projects over at most 120 days, as the person behind the agent and with each query and its numbers kept in the replay record; default "off" leaves the registry and the MCP tool list as they were.
# AGENT_PERFORMANCE_READ=off

# JOBS
# Minutes an agent proposal may sit in 'applying' before the reaper fails it.
# AGENT_PROPOSAL_STUCK_MINUTES=10

# SECURITY
# Set to on (or true) to mark an agent run as tainted once its context takes in content from outside the workspace's own members (a fetched page, an email-in body, a form submission, a webhook payload, uploaded file text or a retrieved passage whose origin is external), and to route a tainted run's risky writes (any escalation under the risk rating, or a write outside the run's own project) to approval with a reason that names the taint. The run, its replay rows, its audit rows and its proposals record where the content came from (a host, an id or a hash), never the content. Unset or off leaves runs, decisions and records exactly as they were.
# AGENT_TAINT_ROUTING=off

# AI
# Upper bound, in minutes, for a task the AI project generator may plan.
# AI_MAX_TASK_MINUTES=""
# model router: "on" lets a caller pick the provider and model per call and lets the workspace routing policy name a model per task class; default "off" keeps the single configured provider answering everything, so a saved policy changes nothing
# AI_MODEL_ROUTER=off
# Which model calls keep a replay record (prompt, raw response, model, revisions; redacted): off, agent (agent runs only) or all.
# AI_REPLAY=agent
# Days a replay record is kept before the TTL index deletes it.
# AI_REPLAY_RETENTION_DAYS=30
# How long a budget reservation holds a workspace's money before it is treated as stranded and stops counting; a process killed mid-call leaves one behind.
# AI_RESERVATION_TTL_MS=900000
# ceiling for one backoff wait, and for a retry-after hint the provider returns
# AI_ROUTER_BACKOFF_MAX_MS=8000
# base delay for the jittered exponential backoff between retries of a transient provider error
# AI_ROUTER_BACKOFF_MS=500
# how long a breaker stays open before it half-opens for one probe; doubles on each failed probe
# AI_ROUTER_BREAKER_COOLDOWN_MS=30000
# ceiling for the doubling breaker cooldown
# AI_ROUTER_BREAKER_MAX_COOLDOWN_MS=300000
# share of provider-caused failures in the window that opens the breaker (0..1)
# AI_ROUTER_BREAKER_THRESHOLD=0.5
# calls needed in the health window before the circuit breaker may open, so one bad call cannot trip it
# AI_ROUTER_BREAKER_VOLUME=5
# requests per minute for a provider with no entry in AI_ROUTER_RATE_LIMITS; 0 means no bucket
# AI_ROUTER_DEFAULT_RPM=0
# most recent calls kept per provider and model in the health window
# AI_ROUTER_HEALTH_SAMPLES=50
# how far back the per-provider health window looks when computing success rate, latency and the breaker
# AI_ROUTER_HEALTH_WINDOW_MS=300000
# attempts on one provider before the router fails over to the next candidate (router flag on only)
# AI_ROUTER_MAX_ATTEMPTS=2
# per-provider request-per-minute budgets as token buckets, e.g. "openai:500,anthropic:200"; empty means no bucket
# AI_ROUTER_RATE_LIMITS=""
# longest the router waits for a rate-limit token before taking the next candidate instead
# AI_ROUTER_RATE_WAIT_MS=2000

# GENERAL
# Set by the Docker image so defaults suit a container (storage under /app/storage).
# ALIANHUB_DOCKER=""

# SECURITY
# Longest lifetime, in days, of an API token while API_TOKEN_STRICT is on. Can only lower the 365-day maximum: a value above 365 or not a whole number of days is ignored with a warning at boot. Ignored while API_TOKEN_STRICT is off.
# API_TOKEN_MAX_DAYS=365
# Set to true to require an expiry and at least one scope on every new API token, and to allow a token without an expiry only to be revoked. A token without an expiry keeps working for 30 days from the later of its creation and when this was first on for the instance (recorded once as apiTokenStrictSince on the instance settings document and kept across backup restores), then stops. A new token may last at most API_TOKEN_MAX_DAYS (365 by default); an older token that expires later works for that many days from the later of its creation and when the maximum first applied (recorded once as apiTokenMaxLifetimeSince, also kept across restores), then stops. Unset or false keeps the old rules.
# API_TOKEN_STRICT=false
# Set to true to chain every new audit row per company: each row carries a sequence number, the previous row's hash and an HMAC-SHA256 keyed with AUDIT_CHAIN_KEY, a change to a row is appended as a new row instead of editing it, retention anchors the rows it deletes and keeps audit rows at least as long as agent runs, and the audit log reports each row as verified, broken or unchained. Names, email, IP address and user agent are outside the hash. Needs AUDIT_CHAIN_KEY; without a valid key the chain stays off and an error is logged. Unset or false keeps rows unchained and edited in place.
# AUDIT_CHAIN=false
# Secret of at least 32 characters that keys the audit chain hash, so someone who can write to the database cannot recompute it. Rows chained under one key only verify under that key; keep it out of the database and its backups. It also keys the pseudonyms that redacting a person in audit rows writes (erased-user-<hash of the user id>), falling back to JWT_SECRET when this key is unset or invalid; after the key changes a person gets a new pseudonym, and running the redaction again changes nothing already redacted. The key cannot change once AUDIT_CHAIN has been on: rows, chain heads and anchors do not record which key signed them, so under a new key every older chained row would read as broken. The first start with AUDIT_CHAIN on and a valid key stores a fingerprint of the key (an HMAC-SHA256 of a fixed label under it, never the key) in the audit_chain_key collection of the global database; every later start with AUDIT_CHAIN on and a different key refuses to start, logging a fatal error and exiting with status 1, until the previous key is set back. With AUDIT_CHAIN off nothing is checked or stored, and a missing or short key still only turns the chain off.
# AUDIT_CHAIN_KEY=""  # secret
# Most rows one audit-log CSV export streams; a last row says when the filter held more. Can only lower the hard cap.
# AUDIT_EXPORT_MAX_ROWS=100000
# Days to keep audit-log entries before the recorder prunes them.
# AUDIT_RETENTION_DAYS=""

# MAIL
# Default From address when mail is sent through AWS SES.
# AWS_SES_FROM_DEFAULT=""
# AWS access key for SES mail delivery.
# AWS_SES_KEY=""  # secret
# AWS region of the SES account.
# AWS_SES_REGION=""
# AWS secret key for SES mail delivery.
# AWS_SES_SECRET=""  # secret

# GENERAL
# Directory where in-app backups are written (default backups/).
# BACKUP_DIR=backups

# LIMITS
# Maximum JSON/urlencoded/raw request body (body-parser size string).
# BODY_LIMIT=2mb

# SERVER
# Per-command timeout, in ms, for the git calls that resolve the running version. On timeout the server reports channel unknown and retries in the background.
# BUILD_INFO_GIT_TIMEOUT_MS=10000

# STORAGE
# Key used to encrypt cloud-storage provider credentials at rest.
# CLOUD_STORAGE_ENC_KEY=""  # secret

# LIMITS
# Largest file the cloud-storage importer will copy into a project.
# CLOUD_STORAGE_MAX_IMPORT_BYTES=""

# GENERAL
# Run the scheduled jobs in this process (default true; set false on extra replicas).
# CRON_ENABLED=""

# JOBS
# IANA time zone for scheduled jobs (reminders, digests).
# CRON_TZ=UTC

# SECURITY
# Extra hosts for the connect-src directive of the content security policy (API, XHR and websocket calls), separated by spaces and written with their scheme, such as https://cdn.example.com or https://*.example.com. Quotes, keywords such as 'unsafe-eval', semicolons, commas, schemes on their own, a bare * and a wildcard over a top-level domain, a public suffix or a shared hosting domain stop the server at boot, whatever CSP_MODE is. Read at boot.
# CSP_EXTRA_CONNECT_SRC=""
# Extra hosts for the font-src directive of the content security policy (fonts), separated by spaces and written with their scheme, such as https://cdn.example.com or https://*.example.com. Quotes, keywords such as 'unsafe-eval', semicolons, commas, schemes on their own, a bare * and a wildcard over a top-level domain, a public suffix or a shared hosting domain stop the server at boot, whatever CSP_MODE is. Read at boot.
# CSP_EXTRA_FONT_SRC=""
# Extra hosts for the form-action directive of the content security policy (form posts), separated by spaces and written with their scheme, such as https://cdn.example.com or https://*.example.com. Quotes, keywords such as 'unsafe-eval', semicolons, commas, schemes on their own, a bare * and a wildcard over a top-level domain, a public suffix or a shared hosting domain stop the server at boot, whatever CSP_MODE is. Read at boot.
# CSP_EXTRA_FORM_ACTION=""
# Extra hosts for the frame-ancestors directive of the content security policy (sites that may frame AlianHub), separated by spaces and written with their scheme, such as https://cdn.example.com or https://*.example.com. Quotes, keywords such as 'unsafe-eval', semicolons, commas, schemes on their own, a bare * and a wildcard over a top-level domain, a public suffix or a shared hosting domain stop the server at boot, whatever CSP_MODE is. Read at boot.
# CSP_EXTRA_FRAME_ANCESTORS=""
# Extra hosts for the frame-src directive of the content security policy (framed pages), separated by spaces and written with their scheme, such as https://cdn.example.com or https://*.example.com. Quotes, keywords such as 'unsafe-eval', semicolons, commas, schemes on their own, a bare * and a wildcard over a top-level domain, a public suffix or a shared hosting domain stop the server at boot, whatever CSP_MODE is. Read at boot.
# CSP_EXTRA_FRAME_SRC=""
# Extra hosts for the img-src directive of the content security policy (images), separated by spaces and written with their scheme, such as https://cdn.example.com or https://*.example.com. Quotes, keywords such as 'unsafe-eval', semicolons, commas, schemes on their own, a bare * and a wildcard over a top-level domain, a public suffix or a shared hosting domain stop the server at boot, whatever CSP_MODE is. Read at boot.
# CSP_EXTRA_IMG_SRC=""
# Extra hosts for the media-src directive of the content security policy (audio and video), separated by spaces and written with their scheme, such as https://cdn.example.com or https://*.example.com. Quotes, keywords such as 'unsafe-eval', semicolons, commas, schemes on their own, a bare * and a wildcard over a top-level domain, a public suffix or a shared hosting domain stop the server at boot, whatever CSP_MODE is. Read at boot.
# CSP_EXTRA_MEDIA_SRC=""
# Extra hosts for the script-src directive of the content security policy (scripts), separated by spaces and written with their scheme, such as https://cdn.example.com or https://*.example.com. Quotes, keywords such as 'unsafe-eval', semicolons, commas, schemes on their own, a bare * and a wildcard over a top-level domain, a public suffix or a shared hosting domain stop the server at boot, whatever CSP_MODE is. In script-src and worker-src, sources must be https, may not be on a domain where anyone can publish (github.io, googleusercontent.com, githubusercontent.com and similar) must name exact hosts (no wildcard), and on a package CDN (cdn.jsdelivr.net, unpkg.com, cdnjs.cloudflare.com) must name one package and its version. Read at boot.
# CSP_EXTRA_SCRIPT_SRC=""
# Extra hosts for the style-src directive of the content security policy (style sheets), separated by spaces and written with their scheme, such as https://cdn.example.com or https://*.example.com. Quotes, keywords such as 'unsafe-eval', semicolons, commas, schemes on their own, a bare * and a wildcard over a top-level domain, a public suffix or a shared hosting domain stop the server at boot, whatever CSP_MODE is. Read at boot.
# CSP_EXTRA_STYLE_SRC=""
# Extra hosts for the worker-src directive of the content security policy (workers), separated by spaces and written with their scheme, such as https://cdn.example.com or https://*.example.com. Quotes, keywords such as 'unsafe-eval', semicolons, commas, schemes on their own, a bare * and a wildcard over a top-level domain, a public suffix or a shared hosting domain stop the server at boot, whatever CSP_MODE is. In script-src and worker-src, sources must be https, may not be on a domain where anyone can publish (github.io, googleusercontent.com, githubusercontent.com and similar) must name exact hosts (no wildcard), and on a package CDN (cdn.jsdelivr.net, unpkg.com, cdnjs.cloudflare.com) must name one package and its version. Read at boot.
# CSP_EXTRA_WORKER_SRC=""
# Content security policy: off (no policy header, the default), report (Content-Security-Policy-Report-Only: nothing is blocked, and what would be is counted under Instance > Enforcement) or enforce (Content-Security-Policy: the browser blocks it). The policy is built on the first request from the storage endpoint and whether push is configured (restart to change them), and follows WEBURL and APIURL when they change; the public share and form pages keep their own stricter policy, and the Google Drive picker runs in its own popup page (/pickers/google-drive) whose policy allows eval for Google's picker script only, so installs using Drive may run enforce. Violation reports go to POST /api/v2/csp-report, which keeps the day, directive, blocked host and page path shape for 30 days and nothing else. Run report until the list is quiet, then enforce. An unknown value stops the server at boot. Read at boot.
# CSP_MODE=off
# Emergency switch, never for normal running. Set to true to skip the per-key permission checks for API tokens and project edits, and to judge a workspace set to enforce in report mode: recorded, never refused. That covers browser sessions and API tokens on the task actions mapped after the first nine (Config/taskWritePermissions.js). Role guards stay on for API tokens, and so does the refusal of a task write body that names another company or an id that cannot be read.
# DISABLE_PERMISSION_ENFORCEMENT=""

# MAIL
# Domain of the inbound-email addresses that create tasks.
# EMAIL_IN_DOMAIN=inbox.alianhub.com

# AI
# Number of historical tasks sampled when the AI estimates effort.
# ESTIMATE_SAMPLES=""
# Target accuracy band the AI estimator calibrates against.
# ESTIMATE_TARGET=""
# Set to on (true, 1 and yes mean the same) to let a person delegate a task to an approved outside OAuth client (MCP_OAUTH). The person must be able to edit the task and hold a live grant to that client in the workspace; the assignee stays, and an unassigned task is given to the delegating person, who is notified. A task in a private sprint can be delegated only by a member of that sprint and only to a client whose workspace approval has the private-sprint opt-in; without the approvals collection it is refused. An owner or admin sets each client's delivery URL under PUT /api/v2/agent-sessions/endpoints (https on a public host, or http to a host in WEBHOOK_ALLOWED_PRIVATE_HOSTS, and on the workspace egress allowlist when AGENT_EGRESS_ALLOWLIST is on) and receives its signing secret once. Delegating sends a webhook through the agents' egress gateway, with X-AlianHub-Timestamp (Unix seconds) and X-AlianHub-Signature, sha256= the HMAC-SHA256 of <timestamp>.<body> under that secret; receivers should reject a timestamp more than 300 seconds from their clock (replayWindowSeconds in the body), carrying the session id, the task and a five-minute session handle, never a token; the ten-second first-activity clock starts when the client answers 2xx, and an untaken offer is marked unresponsive then, a late first activity is refused however it arrives (a sweep every 15 seconds and on boot decides timers lost to a restart). The client reports over /mcp with the tools session.activity (thought, action, elicitation, response or error, 4000 characters, 60 a minute), session.complete and session.fail, each needing tasks:write, the session's own client and grant, an open session and a person behind the grant who can still open the task; the first call carries the handle. Sessions count as tainted and are audited as the client acting for the person. Revoking the grant, the client or its workspace approval, withdrawing the private-sprint opt-in, or moving the task into a private sprint the delegating person is not on marks open sessions revoked. An unassigned task can be delegated only by someone who may assign it. The task panel's agent strip shows the session and its latest activities, pushed over the task's socket room to people who can open the task. Unset or off registers none of this (no routes, no JWT prefix, no session tools or scopes, no socket relay) and the strip, the MCP tool list and the socket rooms are as before.
# EXTERNAL_AGENT_SESSIONS=off
# Set to on (true, 1 and yes mean the same), with EXTERNAL_AGENT_SESSIONS and WORKFLOW_ENGINE on, to register the external_agent workflow step type: its config names an outside OAuth client approved in the workspace (clientId), a task (taskId, or the task the run was started on) and an optional deadline (deadlineMs, default one hour, never past the run's own). On its first claim the step delegates the task to that client as the person who started the run, one session per run and step however often it is claimed, and waits without holding a worker; it succeeds with the session's response when the client completes it, and fails, without retrying, when the client reports an error, the session goes unresponsive or is revoked, or the deadline passes, which also closes the session. Every session call and every tool call from the grant of a session bound to a waiting step is checked live: the session open, the run running, the step still waiting for that session, and the grant and client approval live; a failed check refuses the call and closes the session. A call with an access token whose grant was revoked is answered 401, revokes the sessions that grant held on waiting steps, fails those steps with the reason and records the refusal as the client acting for the delegating person. The step never hands its step credential to the client. Unset or off, the step type is not registered, offered to the builder or accepted in a definition.
# EXTERNAL_AGENT_STEPS=off

# LOGGING
# Upper bound, in milliseconds, that a fatal crash waits for flushers (log files, telemetry exporter, crash report mail) before the process exits with 1.
# FATAL_FLUSH_TIMEOUT_MS=3000

# LIMITS
# Maximum attachments on one public form submission.
# FORM_MAX_FILES=3
# Maximum size of one public form attachment.
# FORM_MAX_FILE_BYTES=""

# BILLING
# Companies a user may create on the free plan.
# FREE_COMPANY_COUNT=""

# JOBS
# Cron expression for the general reminders scheduler.
# GENERAL_REMINDERS_CRON=""

# INTEGRATIONS
# Token used to read release notes from GitHub for the changelog page.
# GITHUB_TOKEN=""  # secret

# SECURITY
# Requests per minute allowed per IP by the global rate limiter.
# GLOBAL_RATE_LIMIT_PER_MIN=""

# AI
# Google AI Studio API key, used when LLM_PROVIDER is google.
# GOOGLE_API_KEY=""  # secret
# optional: override the Google generative-language base URL (e.g. for a compatible proxy)
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
# Gemini model id, e.g. gemini-3-flash / gemini-3-pro / gemini-2.5-flash
# GOOGLE_MODEL=gemini-3-flash

# INTEGRATIONS
# Google OAuth client id accepted when verifying Google sign-in tokens.
# GOOGLE_OAUTH_CLIENT_ID=""

# AI
# optional: override the Google axios timeout (default: LLM_TIMEOUT_MS for thinking models, 4 min for the rest)
# GOOGLE_TIMEOUT_MS=600000

# GENERAL
# How long /health waits for the database ping before reporting it down (default 2000).
# HEALTH_DB_TIMEOUT_MS=""

# SECURITY
# Send the helmet security headers (default true).
# HELMET_ENABLED=""
# Shared key that grants the instance-admin API without a product-owner session.
# INSTANCE_ADMIN_KEY=""  # secret

# AI
# Agent memory in the knowledge index: "off" publishes and indexes nothing, so agent notes stay in the LangGraph store only; "on", for a company whose knowledge indexer is on, indexes each agent note (agent_memory, namespace agent/<agentId>/note) into knowledge_chunks under scope "agent" off the memory events, backfills existing notes in the knowledge.memory.backfill job, and lets an agent's own runs retrieve its notes once that backfill is complete: only within the run's visible set (the starter's projects, narrowed to the agent's), only when every project the note was formed in is in that set, ranked below what people wrote, and with origin "external" when a tainted run formed it. People asking through Ask never see agent notes.
# KNOWLEDGE_AGENT_MEMORY=off
# With KNOWLEDGE_VECTOR_STORE=atlas, how many candidates Atlas considers for each chunk it returns (numCandidates is at least this times the limit, at most 10000).
# KNOWLEDGE_ATLAS_CANDIDATE_RATIO=10
# With KNOWLEDGE_VECTOR_STORE=atlas, how long, in milliseconds, the knowledge.backfill job gives one tenant's index check before moving on; tenants are checked four at a time.
# KNOWLEDGE_ATLAS_INDEX_BUDGET_MS=30000
# With KNOWLEDGE_VECTOR_STORE=atlas, how long, in milliseconds, each step of a tenant's index check (listing, creating or updating the search index, reading a stored vector) may take before the check records the index state as timed out. Questions never wait on a check.
# KNOWLEDGE_ATLAS_INDEX_TIMEOUT_MS=5000
# With KNOWLEDGE_VECTOR_STORE=atlas, how long, in milliseconds, one vector search may run before the question is answered from the lexical side (the backend then reads "lexical (vector store timed out)").
# KNOWLEDGE_ATLAS_MAX_TIME_MS=3000
# With KNOWLEDGE_VECTOR_STORE=atlas, the fewest nearest chunks Atlas considers per source type for a question ($vectorSearch numCandidates); raised to KNOWLEDGE_ATLAS_CANDIDATE_RATIO times the limit when that is more, and at most 10000.
# KNOWLEDGE_ATLAS_NUM_CANDIDATES=1000
# With KNOWLEDGE_VECTOR_STORE=atlas, when Atlas returns a full limit of chunks but fewer than this many passages survive the access check, the answer's backend reads "lexical+vector-atlas(thin)", so a vector side crowded out by chunks the asker may not see is visible.
# KNOWLEDGE_ATLAS_THIN_RESULTS=3
# With KNOWLEDGE_VECTOR_STORE=atlas, how many chunks per source type Atlas returns for a question ($vectorSearch limit) before they are narrowed by access and collapsed to one passage per source; never fewer than the passages asked for.
# KNOWLEDGE_ATLAS_VECTOR_LIMIT=100
# With KNOWLEDGE_VECTOR_STORE=atlas, the vector size the Atlas index is built for. Leave unset to take it from a stored vector of KNOWLEDGE_EMBEDDING_MODEL, or from the model (1536 for text-embedding-3-small, 3072 for text-embedding-3-large); set it for any other model. A value that disagrees with a stored vector of the model, or with the model's known size, builds no index: the console shows the index as the wrong size and questions stay lexical.
# KNOWLEDGE_EMBEDDING_DIMENSIONS=""
# The OpenAI embedding model a hybrid company's chunks and questions are embedded with. It must have a price on file (text-embedding-3-small and text-embedding-3-large do; LLM_PRICING adds another); a change re-embeds each chunk on its next write and, a batch per run, from the recurring knowledge.backfill job.
# KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
# How long a question waits for its embedding before Ask answers from the lexical side alone (the backend then reads "lexical (embed timed out)"). Embedding at ingest keeps the provider's own timeout.
# KNOWLEDGE_EMBED_QUERY_TIMEOUT_MS=2000
# How long, in milliseconds, the database may spend reading one workspace's knowledge figures for the instance console before the console says the figures timed out.
# KNOWLEDGE_FIGURES_MAX_TIME_MS=10000
# The largest task attachment, in bytes, whose text the knowledge indexer extracts. A larger file is recorded as skipped and never read.
# KNOWLEDGE_FILE_MAX_BYTES=10485760
# How many characters of one file's text the knowledge indexer keeps; the rest is cut and a truncation marker added.
# KNOWLEDGE_FILE_MAX_CHARS=200000
# How many pages of a PDF the knowledge indexer reads.
# KNOWLEDGE_FILE_MAX_PAGES=200
# How much memory one file's parser thread may hold (its heap plus off-heap buffers, measured by the thread itself where the parser yields, with the process's resident growth watched as a backstop for a parser that never yields) before the knowledge indexer stops it and records the file for a retry. By default twice KNOWLEDGE_FILE_MAX_UNZIPPED_BYTES (the rebuilt archive plus one entry being copied into it) plus 128 MB for the parser.
# KNOWLEDGE_FILE_MAX_PARSE_MEMORY_BYTES="2 x KNOWLEDGE_FILE_MAX_UNZIPPED_BYTES + 134217728"
# How many rows of each sheet or CSV the knowledge indexer reads.
# KNOWLEDGE_FILE_MAX_ROWS=5000
# How many sheets of a spreadsheet the knowledge indexer reads.
# KNOWLEDGE_FILE_MAX_SHEETS=20
# The most a DOCX or XLSX may inflate to. The knowledge indexer refuses one that declares more without opening it, and inflates every entry itself against this budget, whatever the archive declares, before a parser sees it.
# KNOWLEDGE_FILE_MAX_UNZIPPED_BYTES=104857600
# How long the knowledge indexer lets one file's parser run before stopping its thread and recording the file as timed out. A failed or timed-out file is retried at most twice.
# KNOWLEDGE_FILE_TIMEOUT_MS=20000
# Seconds a company's knowledgeRetrieval and knowledgeIndexer modes are kept after one read, so a question, a sync and a retry share it; 0 reads the row on every call, which the e2e harness sets so a test sees a switch it just flipped.
# KNOWLEDGE_FLAG_CACHE_TTL_SECONDS=30
# Knowledge indexer: "off" subscribes to nothing and reads or writes no chunk; "tenant" ingests page, comment, call-notes, project-guide and task-attachment events into knowledge_chunks (pages and guides split on headings; attachment text extracted off the request path within the KNOWLEDGE_FILE_* limits; tombstoned on delete, on a deleted task or a removed attachment for comments and files, on project trash for pages, comments, guides and files, and on a member's departure for private pages), backfills each source separately, and lets retrieval read a source's passages from the chunks once that source's backfill is complete, for a company whose knowledgeIndexer.mode is "on"; "all" does so for every company except one set to "off".
# KNOWLEDGE_INDEXER=off
# Knowledge retrieval for Ask: "off" gathers sources exactly as before (task fields and page titles by regular expression); "tenant" searches tasks, page bodies and comments through the full-text indexes, and the caller's own call transcripts, with access control applied at query time, for a company whose knowledgeRetrieval.mode is "on" or "hybrid"; "all" does so for every company except one set to "off". A company in "hybrid" also has its chunks embedded as they are indexed (KNOWLEDGE_EMBEDDING_MODEL, with the OpenAI instance key) and each question embedded once, and its answers fuse the lexical and vector candidates by reciprocal rank under the same access filter; "on" stays lexical.
# KNOWLEDGE_RETRIEVAL=off
# Where hybrid knowledge retrieval searches vectors: "local" scores the newest chunks of each source in process from the tenant database (any MongoDB); "atlas", for hosted deployments on MongoDB Atlas, searches the same chunk rows with Atlas Vector Search through one knowledge_chunks_vector index in the database of each tenant whose knowledgeRetrieval mode is "hybrid", created or checked in the background at tenant creation and by the knowledge.backfill job (which also creates it once a tenant switches to hybrid), with the index state shown in the instance knowledge console. Atlas caps the number of search indexes a cluster may hold, lower on shared and free tiers, so check the tier's limit against the number of hybrid tenants. While a tenant's index is being checked, missing, building or the wrong size, or Atlas cannot answer, questions are answered from the lexical side. Any other value is read as "local".
# KNOWLEDGE_VECTOR_STORE=local
# optional: the inference region the provider is pinned to; shown read-only in the agent settings (GET /api/v2/agents/settings)
# LLM_REGION=""

# LOGGING
# Date pattern appended to rotated log file names.
# LOG_DATE_PATTERN=YYYY-MM-DD
# Directory that receives the rotated log files.
# LOG_DIR=log
# Log file record format: text (one formatted line) or json (one { ts, level, label, requestId, traceId, message } record per line).
# LOG_FORMAT=text
# Retention window for rotated log files (winston-daily-rotate-file).
# LOG_MAX_FILES=14d
# Size at which a log file rotates.
# LOG_MAX_SIZE=20m

# AUTH
# Set to false to disable passwordless magic-link sign-in.
# MAGIC_LINK_ENABLED=true

# SECURITY
# Key that signs the MCP list cursors (HMAC-SHA256) while MCP_TOOLS_V2 is on. A cursor is bound to the company, the caller, the token and the query, and expires after an hour. Unset derives a key from JWT_SECRET; changing it ends the cursors in flight. With MCP_TOOLS_V2 on the server refuses to start when it is set but shorter than 32 characters or equal to JWT_SECRET.
# MCP_CURSOR_SECRET=""
# Set to both (on, true, 1 and yes mean the same) or only to run the OAuth 2.1 authorization server for the MCP endpoint (MCP authorization spec 2025-11-25): GET /.well-known/oauth-authorization-server, /oauth/authorize (authorization code with PKCE S256 only, resource required and equal to <issuer>/mcp, exact redirect URI match except that an http loopback redirect may use any port, https or loopback redirects; scope may be left out for read-only access), /oauth/token (single-use codes, rotating refresh tokens, a reused code or refresh token revokes its whole grant), /oauth/revoke (RFC 7009), and /api/v2/oauth-clients for workspace owners and admins to pre-register clients. Clients may also identify themselves with a client ID metadata document, fetched through the agents' SSRF-safe fetch (5 KB, 5 s, no redirects, one fetch per URL at a time, a failed URL retried after 5 s). Codes, tokens and client secrets are stored only as keyed hashes; every token is bound to one workspace, one person and the /mcp resource. The consent screen is not built yet, so an authorization cannot complete outside a test process. On the resource side, GET /.well-known/oauth-protected-resource and /.well-known/oauth-protected-resource/mcp (RFC 9728) name the /mcp resource, this authorization server and the scopes tasks:read tasks:write projects:read docs:read time:read time:write; a 401 from /mcp carries resource_metadata and the scopes the call needs; a call whose token lacks a scope answers 403 insufficient_scope naming it; access tokens in the query string are refused; initialize also negotiates protocol version 2025-11-25. /mcp accepts these access tokens in the Authorization header only: the token must be live, bound to the <issuer>/mcp resource, its grant unrevoked and within its cap, its client unrevoked; the token's workspace is the only workspace, so a companyId in the query or header naming another is refused with 403; its six scopes decide every tool; a session cookie or Mcp-Session-Id is never authorization; the token is never forwarded to any outbound call; actions are audited as the outside client acting for the person who granted it (viaAccount external, clientId, grantId, delegatedBy), the API activity log names the client, and they count as tainted, so under AGENT_TAINT_ROUTING a risky write is refused with a reason saying it needs a person's approval; an unsupported MCP-Protocol-Version header is answered 400. With both, personal access tokens keep working (read grants every *:read scope, write every *:write); with only, a personal access token gets 401 with the challenge. Unset or off registers none of these routes and /mcp answers exactly as before.
# MCP_OAUTH=off
# Lifetime of an MCP OAuth access token, in minutes. Never longer than the grant it belongs to.
# MCP_OAUTH_ACCESS_TOKEN_MINUTES=15
# How long a fetched client ID metadata document is cached when it sends no Cache-Control max-age (a max-age is followed up to a day; no-store is never cached).
# MCP_OAUTH_CLIENT_METADATA_CACHE_SECONDS=300
# With MCP_OAUTH on, set to on to open RFC 7591 dynamic client registration at /oauth/register and advertise it in the server metadata. Off by default: clients use a client ID metadata document or are pre-registered by a workspace owner or admin.
# MCP_OAUTH_DCR=off
# Longest an MCP OAuth grant lives, in days, however often its refresh token is rotated; after it the person authorizes the client again.
# MCP_OAUTH_GRANT_MAX_DAYS=90
# Issuer URL of the MCP authorization server, and the base of its endpoints and of the /mcp resource tokens are bound to. Defaults to APIURL. It must be an origin (no path, query or fragment) and https; plain http is accepted only on localhost, 127.0.0.1 or [::1] while NODE_ENV is unset, development or test. With MCP_OAUTH on, any other value stops the server at boot.
# MCP_OAUTH_ISSUER=""
# Requests per minute per client address to /oauth/authorize, and separately to /oauth/token with /oauth/revoke, before the MCP authorization server answers 429.
# MCP_OAUTH_RATE_LIMIT_PER_MIN=30
# Lifetime of an MCP OAuth refresh token, in days. Each use spends it and issues a new one; never longer than the grant it belongs to.
# MCP_OAUTH_REFRESH_TOKEN_DAYS=30
# Key for the keyed hashes under which MCP OAuth codes, tokens and client secrets are stored, separate from JWT_SECRET, which is used when this is unset. Changing it invalidates every issued token and every pre-registered client secret.
# MCP_OAUTH_TOKEN_SECRET=""  # secret

# AI
# MCP data tools: "on" registers and offers projects.list, project.get, sprints.list, statuses.list, comments.list, pages.search, page.get and timesheet.read (reads), and comment.create and timelog.create (the caller's own time), each a rated registry action that answers only what the person behind the token can open in the web app and needs its own OAuth scope. Default "off" leaves the registry and the MCP tool list as they were.
# MCP_TOOLS_DATA=off
# MCP tools v2: "on" puts human names and a ref next to the ids in tool results (only names the caller may see), pages every list tool with an opaque cursor (default 25, at most 100 per page), annotates every tool with readOnlyHint, destructiveHint, idempotentHint and openWorldHint from its action rating, and turns a destructive call (an irreversible or workspace-scope write) into a proposal a person approves in the Inbox instead of acting. Default "off" keeps the tool list and result shapes as they were.
# MCP_TOOLS_V2=off

# GENERAL
# Apply pending migrations at boot (default true; false only reports them).
# MIGRATIONS_AUTO=""

# DATABASE
# How long a new MongoDB connection may take to establish (default 60000).
# MONGO_CONNECT_TIMEOUT_MS=60000
# Minimum connections kept open per company database.
# MONGO_MIN_POOL_SIZE=""
# Maximum connections per company database.
# MONGO_POOL_SIZE=""
# How long the MongoDB driver waits to find a usable server before failing an operation (default 60000).
# MONGO_SERVER_SELECTION_TIMEOUT_MS=60000
# Inactivity timeout on a MongoDB socket before it is closed (default 300000).
# MONGO_SOCKET_TIMEOUT_MS=300000
# How long a query waits for a free connection before failing.
# MONGO_WAIT_QUEUE_TIMEOUT_MS=""

# MAIL
# Accept self-signed certificates from the SMTP server.
# NODEMAILER_ALLOW_SELF_SIGNED=""

# JOBS
# Minutes a user counts as active for notification batching.
# NOTIFICATIONACTIVETIME=""

# AI
# The endpoint the OpenAI provider posts embeddings to. Point it at an Azure deployment, a proxy or a self-hosted server that speaks the same API; the e2e harness points it at a stub. Chat completions are unaffected.
# OPENAI_EMBEDDINGS_URL=https://api.openai.com/v1/embeddings

# LOGGING
# OTLP/HTTP collector base URL (traces go to <endpoint>/v1/traces). Unset keeps the OpenTelemetry SDK and exporter off; trace ids are still recorded.
# OTEL_EXPORTER_OTLP_ENDPOINT=""
# service.name reported on exported spans.
# OTEL_SERVICE_NAME=alianhub

# BILLING
# Payment provider used at sign-up (chargebee or paddle).
# PAYMENTMETHOD=""

# SECURITY
# Seconds a workspace's own permissionEnforcement.mode is cached before the company row is read again; 0 reads it on every guarded request. A failed read inherits the instance default for 5 seconds whatever this is set to.
# PERMISSION_ENFORCEMENT_CACHE_TTL_SECONDS=30
# Server-side permission checks for browser sessions: off (they pass as before), report (they pass, and each would-be denial is recorded in permission_decisions) or enforce (they are refused, and a check that cannot complete fails closed). The default for every workspace; a company row's permissionEnforcement.mode overrides it. Anything unrecognised reads as off. API tokens are always enforced on the keys they were refused on before, including nine task actions; on every other task write in Config/taskWritePermissions.js they follow this mode like browser sessions. A task write body that names another company or an id that cannot be read is refused for API tokens in every mode, and follows this mode for browser sessions. Also editable under Instance > Settings > Security.
# PERMISSION_ENFORCEMENT_MODE=off

# AUTH
# Seconds after a refresh token is rotated during which presenting the old one again is refused without revoking the session, so parallel requests or tabs do not log the user out. Past this window a reused token revokes the session.
# REFRESH_TOKEN_REUSE_GRACE_SECONDS=10

# STORAGE
# Connection timeout for S3-compatible storage calls.
# S3_CONNECTION_TIMEOUT_MS=""
# Socket timeout for S3-compatible storage calls.
# S3_SOCKET_TIMEOUT_MS=""

# SECURITY
# Key of at least 32 characters that seals the secrets store, separate from JWT_SECRET. Each stored secret records the id of the key that sealed it (derived from the stretched key, so it is no shortcut for guessing the key); keep the key out of the database and its backups. To rotate, move the old value to SECRETS_KEY_PREVIOUS, set the new one here, restart, and run `npm run secrets:reencrypt`.
# SECRETS_KEY=""  # secret
# The previous SECRETS_KEY during a key rotation: secrets sealed under it still resolve, and `npm run secrets:reencrypt` reseals every company under SECRETS_KEY, writes an audit row per company and prints how many live secrets are still on this key. Unset it only when that command says it is safe to.
# SECRETS_KEY_PREVIOUS=""  # secret
# Set to true to keep integration and webhook secrets in a per-company secrets store, referenced by handle: a new or updated secret is sealed with AES-256-GCM under SECRETS_KEY and bound to its company and handle, the integration or webhook document keeps only the handle, every create, rotation, revocation and failed lookup is audited, and owners and admins see each secret's name, kind, key id and dates under Settings → Integrations, where they can rotate or revoke it. Migration 031 moves existing secrets in when this is on while it runs. Needs SECRETS_KEY; with a missing or short key the store refuses every read and write, connecting an integration or adding a webhook is refused rather than saved outside the store, and an error is logged. Unset or false keeps secrets sealed on their documents as before; a handle already written still resolves while a key is set, and a secret saved while this is off replaces the handle on its document, so the newest value is always the one in use. Turning this off again: the old store copy is revoked when SECRETS_KEY is still set, and otherwise marked, then revoked by `npm run secrets:reencrypt` (or by migration 031 when it runs again) once a key is set.
# SECRETS_STORE=false

# SERVER
# How long the HTTP server waits for a full request header block; always kept above the keep-alive timeout (default 66000).
# SERVER_HEADERS_TIMEOUT_MS=66000
# Idle keep-alive timeout of the HTTP server; keep it above the idle timeout of any proxy in front (default 65000).
# SERVER_KEEP_ALIVE_TIMEOUT_MS=65000
# How long the HTTP server waits to receive a whole request (default 300000). Server-sent event streams are exempt.
# SERVER_REQUEST_TIMEOUT_MS=300000

# AUTH
# Idle time after which a login session expires.
# SESSIONEXPIREDTIME=172800
# Set to on to mark the session cookies httpOnly so page JavaScript can no longer read them: the server reads the access token from the cookie when no Authorization header is sent, the socket handshake and the refresh endpoint do the same, and the web app authenticates by cookie instead of copying tokens into headers. Tracker, CLI and API-token clients are unaffected (they send headers and bodies, never cookies). Unset or off keeps readable cookies as before.
# SESSION_COOKIE_HTTPONLY=""

# SECURITY
# Declared external reads in data skills: "on" offers the url and api readers in the Skill Library, each naming one exact host, a path template, GET only, at most 512 KB, 10 s and 3 redirects, and optionally the handle of a skill_read workspace secret. A skill is saved only when every declared host is on the workspace egress allowlist (an empty list refuses them all, and private or reserved hosts are refused even when listed), and a raw secret anywhere in the skill body is refused. The built-in pr.summary skill (alias risk.flags) reads its pull request this way from github.com, patch-diff.githubusercontent.com or gitlab.com, each of which must be on the workspace egress allowlist. Default "off" hides the readers and refuses them on save; a skill that declares one, pr.summary included, is listed as unavailable with the reason, and running it fails with external_reads_not_available before anything is fetched.
# SKILL_EXTERNAL_READS=off
# Set to on to give the platform its own service identities and mint a step-scoped credential per workflow step: the workflow engine, its worker, the knowledge indexer and the model router record their rows as service:<name> instead of a borrowed user, and when the engine claims a step it signs a short-lived credential carrying the company, run, step, fencing token, actor context and allowed actions that expires one lease after it was minted, is re-minted whenever a heartbeat extends the lease, and is checked against the live step row whenever an agent step's actor presents it to perform an action. The tokens screen lists live credentials as step-scoped. Unset or off keeps today's behaviour: no credential is minted and rows are attributed as before.
# STEP_CREDENTIALS=off
# Key material for signing step-scoped credentials (STEP_CREDENTIALS). Derived with scrypt, never used as-is; falls back to JWT_SECRET, so set a dedicated secret in production so rotating JWT_SECRET does not invalidate credentials of steps in flight, and keep it out of the database and its backups.
# STEP_CREDENTIAL_SECRET=""  # secret

# STORAGE
# Which stored files a signed download link is issued for. report (the default): every link is issued as before, and each one enforce would refuse is logged as 'stored-file download would be refused' with the key's layout type (task_attachment, channel_comment, form_upload, unknown, ...), a reason category (not_found, no_access, invalid_path, unknown) and a running count per pair, never the key or path. enforce: a link is issued only for a file attached to a record the caller may open (a task, project, comment, channel, direct message, form, clip, reminder, timesheet screenshot, or a company settings image); any other key answers 404 with code STORED_FILE_NOT_AVAILABLE. The same mode governs task attachment writes: under report a task attachment that names a file not stored for that task is written and logged as 'attachment write would be refused' with a reason category (other_task, form_upload, clip, unknown) and a count; under enforce it is refused with 400 ATTACHMENT_KEY_NOT_OWN. An attachment url that is not text is refused in both modes. Anything else reads as report. Switch plan: run one release on report, check the logged counts, and set enforce once no layout other than unknown shows refusals that a legitimate screen caused.
# STORAGE_DOWNLOAD_SCOPE=report

# AI
# Set to on to let each workspace pay for model calls with its own provider keys: owners and admins set one key per provider under Settings, kept in the secrets store by handle with only the handle on the company row, and every model call and embedding run for that workspace is billed to its key, or to the instance key while none is set. A set key that will not open refuses the call rather than billing the instance owner. Needs SECRETS_STORE with SECRETS_KEY; unset or off keeps every call on the instance keys.
# TENANT_PROVIDER_KEYS=""

# AUTH
# ISO date from which desktop tracker builds that sign in without a PKCE verifier are refused. Unset (the default) keeps those builds working; an unparseable value reads as unset.
# TRACKER_PKCE_LEGACY_UNTIL=""

# STORAGE
# Days to keep time-tracker screenshots before deletion.
# TRACKSHOT_RETENTION_DAYS=180

# GENERAL
# Machine-translation key used by scripts/i18n-backfill.js; unset means English copies are written for review.
# TRANSLATE_API_KEY=""  # secret

# SERVER
# Express trust proxy setting; loopback by default so X-Forwarded-For is honoured behind a local reverse proxy.
# TRUST_PROXY=loopback

# LIMITS
# Maximum files per upload request.
# UPLOAD_MAX_FILES=20
# Maximum size of one uploaded file.
# UPLOAD_MAX_FILE_BYTES=""

# SECURITY
# Private hosts webhooks may post to: exact hostnames or CIDR ranges, comma-separated (empty by default, so every private host is refused). Also editable under Instance > Settings > Security. Link-local and cloud metadata addresses stay blocked, and a range can be no wider than /8 (IPv4) or /32 (IPv6).
# WEBHOOK_ALLOWED_PRIVATE_HOSTS=""

# JOBS
# Deadline given to an approval step whose definition names none, so a run cannot wait forever on a decision nobody will make.
# WORKFLOW_APPROVAL_DEADLINE_MS=259200000
# How often a workflow step waiting on a human approval is looked at again. A decision wakes the step immediately; this is the floor that notices a deadline nobody answered.
# WORKFLOW_APPROVAL_POLL_MS=300000
# Comma-separated backoff ladder, in milliseconds, a transient workflow step failure waits between attempts.
# WORKFLOW_BACKOFF_MS="30000,120000,600000"
# Durable workflow runs for automation rules: "off" runs a rule through the automation runner exactly as before, "on" makes it a one-node workflow run with a lease, a claim and engine-scheduled retries.
# WORKFLOW_ENGINE=off
# How often a running workflow step renews its lease. Defaults to a third of WORKFLOW_LEASE_MS.
# WORKFLOW_HEARTBEAT_MS=""
# How often a fan-in join or a loop checks whether the steps it is waiting on have finished.
# WORKFLOW_JOIN_POLL_MS=2000
# How long a claimed workflow step run keeps its lease before another worker may reclaim it. Defaults to the agent run lock, so the two cannot drift.
# WORKFLOW_LEASE_MS=""
# Attempts a workflow step gets before a transient failure is given up on.
# WORKFLOW_MAX_ATTEMPTS=3
# Children one fan-out step may expand into. A workflow definition may ask for fewer, never more; over the bound the step fails instead of doing part of the work.
# WORKFLOW_MAX_FAN_OUT=50
# Iterations a loop step may re-enter its body for. The ceiling a definition's own maxIterations is capped to.
# WORKFLOW_MAX_LOOP_ITERATIONS=25
# Agent runs an hour, per company and per agent, that a workflow loop may admit an iteration for. The ceiling a loop's own maxRunsPerHour and a rule's stored limits.maxRunsPerHour are capped to; 0 means no ceiling for the installation.
# WORKFLOW_MAX_RUNS_PER_HOUR=0
# Ceiling on what a whole workflow run may spend, in dollars. Each step's cost is taken off the run's remaining budget; a step asking for more than remains is refused and the run is marked blocked. Unset means no ceiling.
# WORKFLOW_RUN_BUDGET_USD=""
# Ceiling on how long a whole workflow run may take, in milliseconds. Each step takes its share and hands on what is left; a step asking for more than remains is refused and the run is marked blocked. Unset means no ceiling.
# WORKFLOW_RUN_DEADLINE_MS=""
# How long an hour of an agent's run start times is trusted before it is read again. The hour rolls in memory between reads; this is only how quickly a run another process started is noticed.
# WORKFLOW_RUN_LIMIT_CACHE_MS=60000
# Workflow step runs one tenant may have claimed at once, counted across every worker.
# WORKFLOW_TENANT_CONCURRENCY=5
# ── end generated ──
