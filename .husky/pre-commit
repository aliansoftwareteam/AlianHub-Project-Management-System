# husky puts node_modules/.bin on PATH, so call the binary directly.
# Don't reintroduce `npx`: it resolves through the Windows PATH and exits 127
# under nvm-for-Windows / GUI git clients even when npx exists.
# --no-stash: git's stash is shared by every worktree of this repo. Unstaged hunks
# of partially staged files are still hidden during linting, via a patch file.
lint-staged --no-stash
